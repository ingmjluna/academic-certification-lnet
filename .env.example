# === Credenciales NaaS (Node as a Service de LACNET / LNet) ===
# Usuario = email de tu cuenta NaaS. Se usa para el login en el backend.
LACNET_NAAS_USER=
LACNET_NAAS_PASSWORD=
# Backend NaaS que emite el token de acceso y expone la KMS address.
LACNET_NAAS_API_URL=https://naas.lacnet.com

# === Datos de red ===
LACNET_RPC_URL=https://testnet-naas.lacnet.com/rpc
LACNET_CHAIN_ID=648539
# Opcional: si se deja vacío, la KMS address se obtiene automáticamente de NaaS
# (GET /api/user/kms-id). Solo completar para forzar una dirección concreta.
LACNET_NODE_ADDRESS=

# === Firma de transacciones (gas model de LACNET) ===
# Clave privada (hex, con o sin prefijo 0x) de la cuenta que firma y despliega.
# Debe estar permisionada en la red. NUNCA la subas a GitHub.
LACNET_PRIVATE_KEY=

# Segundos que la transacción es válida en el gas model (por defecto 300 = 5 min).
LACNET_TX_EXPIRATION_SECONDS=300

# Dirección pública de la Universidad (emisora/admin). Debe corresponder a
# LACNET_PRIVATE_KEY. Se usa como owner por defecto de AcademicIdentity.
UNIVERSITY_ADDRESS=

# === Direcciones de contratos ya desplegados (opcional) ===
# Las rellenan automáticamente los scripts de despliegue; las usan issue/verify.
CERTIFICATE_CONTRACT_ADDRESS=
IDENTITY_CONTRACT_ADDRESS=

# === Parámetros por defecto para emitir/verificar credenciales (opcional) ===
STUDENT_ADDRESS=
CREDENTIAL_IPFS_CID=
CREDENTIAL_TYPE=AcademicCertificate
# Id del token a verificar con verify-credential.js
TOKEN_ID=1
